# ==========================================
# WeatherGPT .gitignore
# ==========================================

# Environment Variables & Secrets (CRITICAL)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env.local
frontend/.env.*.local
!frontend/.env.example
*.pem
*.key
*.cert
*.secret

# Python Virtual Environments & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Node.js, Next.js & Frontend Build Outputs
node_modules/
frontend/node_modules/
.next/
frontend/.next/
frontend/out/
frontend/build/
frontend/dist/
frontend/tsconfig.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE, Editor & OS State
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
.tempmediaStorage/
.system_generated/

# Preserve Proof & Project Documentation
!proof/
!proof/**
!README.md
!DEPLOYMENT.md
!requirements.txt
!render.yaml
!vercel.json
