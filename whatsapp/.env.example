# ============================================================================
# WeatherGPT WhatsApp Adapter Configuration
# ============================================================================

# Master kill switch — set to true to enable WhatsApp bot processing
WHATSAPP_BOT_ENABLED=true

# Authoritative Access Control:
# WhatsApp sender authorization is verified LIVE on every message against the
# Emergency Alert subscriber registry persisted in Supabase via the WeatherGPT backend.
# No manual allowlist or local config bypass is used.

# Per-sender rate limit: max messages per minute
WHATSAPP_RATE_LIMIT_PER_MINUTE=5

# Maximum incoming message length (characters).
# Messages exceeding this are rejected with a controlled reply (not silently truncated).
WHATSAPP_MAX_MESSAGE_LENGTH=1000

# URL of the WeatherGPT backend (used for /api/notifications/subscriber/verify and /api/chat)
# In production, set this to your deployed Render URL:
# WEATHERGPT_API_URL=https://your-backend.onrender.com
WEATHERGPT_API_URL=http://localhost:8000
