# ==========================================
# WeatherGPT Environment Configuration Example
# ==========================================
# Note: Never commit real credentials to version control.
# Copy this file to backend/.env and populate with actual credentials.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true
PORT=8000
FRONTEND_PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# AI Provider (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Speech-to-Text (Groq Whisper)
GROQ_API_KEY=your_groq_api_key_here
GROQ_WHISPER_MODEL=whisper-large-v3

# Database & Cache (Optional / Supabase PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Twilio Credentials (SMS, Voice/IVR, WhatsApp)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_SMS_FROM=+1234567890
TWILIO_VOICE_FROM=+1234567890
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+919876543210
TWILIO_WHATSAPP_CONTENT_SID=your_optional_content_sid

# Exotel Credentials (Alternative Telephony Provider)
EXOTEL_ACCOUNT_SID=your_exotel_account_sid_here
EXOTEL_API_KEY=your_exotel_api_key_here
EXOTEL_API_TOKEN=your_exotel_api_token_here
EXOTEL_SUB_DOMAIN=api
EXOTEL_CALLER_ID=your_exotel_caller_id_here

# Meta WhatsApp Cloud API (Alternative WhatsApp Provider)
WHATSAPP_API_TOKEN=your_whatsapp_api_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_here

# Provider Routing Selection
SMS_PROVIDER=twilio
VOICE_PROVIDER=twilio
WHATSAPP_PROVIDER=twilio

# Web Push VAPID Configuration (ECDSA P-256)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_CLAIM_EMAIL=mailto:admin@weathergpt.local

# Emergency Delivery Safety Controls
NOTIFICATION_DRY_RUN=true
ENABLE_LIVE_NOTIFICATION_TESTS=false
TEST_NOTIFICATION_RECIPIENT=+919876543210

# External Open Weather & Disaster Feeds
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
SACHET_NDMA_ALERT_FEED_URL=https://sachet.ndma.gov.in/cap_feed
